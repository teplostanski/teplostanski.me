{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@teplostanski/biome-config/configs/base"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**/*.astro", "**/*.js", "**/*.ts", "**/*.json", "**/*.md", "**/*.css"]
  },
  "formatter": {
    "enabled": true
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedImports": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off"
      }
    }
  },
  "javascript": {
    "formatter": {}
  }
}
