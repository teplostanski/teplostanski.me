---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { links } from '../../data/links'
import { ui } from '../../i18n/ui'
import type { Lang } from '../../i18n/utils'
import PacmanDivider from '../PacmanDivider.astro'

interface Props {
  lang: Lang
}

const { lang = 'en' } = Astro.props as Props
const text = ui[lang]
const projectsUrl = getRelativeLocaleUrl(lang, 'projects')
const linksUrl = getRelativeLocaleUrl(lang, 'links')
const githubUrl = links.find(link => link.name === 'GitHub')!.href
const blueskyUrl = links.find(link => link.name === 'Bluesky')!.href
---

<div class="home-main">
  <p>{text.home.greeting}</p>
  <p>{text.home.about}</p>

  <div class="divider">
    <PacmanDivider />
  </div>

  <nav>
    <ul>
      <li>
        <a class="home-link" href={projectsUrl}>
          {text.navigation.projects}
        </a>
      </li>
      <li>
        <a class="home-link" href={linksUrl}>
          {text.navigation.links}
        </a>
      </li>
      <li>
        <a
          class="home-link"
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {text.navigation.github}
        </a>
      </li>
      <li>
        <a
          class="home-link"
          href={blueskyUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {text.navigation.bluesky}
        </a>
      </li>
    </ul>
  </nav>
</div>

<style>
  .home-main {
    width: 100%;
    max-width: var(--content-width);
  }

  .home-link {
    font-weight: 700;
  }
</style>
