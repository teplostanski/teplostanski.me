---
import { languages } from '../i18n/ui'
import {
  getLangFromUrl,
  getPathWithoutLang,
  useTranslatedPath,
  useTranslations,
} from '../i18n/utils'
import styles from './LanguageSwitcher.module.css'

const pathname = Astro.url.pathname
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
const basePath = getPathWithoutLang(pathname)
const languageKeys = Object.keys(languages) as (keyof typeof languages)[]
---

<details data-language-switcher class={styles.switcher}>
  <summary class={styles.summary}>
    {t(`lang.${lang}` as const) ?? languages[lang]}
  </summary>
  <div data-language-menu class={styles.menu}>
    {languageKeys
      .filter((key) => key !== lang)
      .map((key) => {
        const label = t(`lang.${key}` as const) ?? languages[key]
        const href = translatePath(basePath, key)
        return (
          <a
            href={href}
            class:list={[
              styles.link,
              styles.available,
            ]}
          >
            {label}
          </a>
        )
      })}
  </div>
</details>

<script>
import { replayAnimations } from '../scripts/animate'

document.addEventListener('click', (e) => {
  const target = e.target
  const targetEl = target instanceof Element ? target : null
  document.querySelectorAll('[data-language-switcher][open]').forEach((el) => {
    if (targetEl && el.contains(targetEl)) return
    el.removeAttribute('open')
  })
})

document.addEventListener(
  'toggle',
  (e) => {
    const details = e.target
    if (!(details instanceof HTMLDetailsElement)) return
    if (!details.hasAttribute('data-language-switcher') || !details.open) return

    const menu = details.querySelector<HTMLElement>('[data-language-menu]')
    if (menu) {
      replayAnimations(menu)
    }
  },
  true,
)
</script>
