---
import '../styles/global.css'
import '../styles/themes.css'
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { Lang } from '../i18n/utils'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const targetLang = lang === 'en' ? 'ru' : 'en'
const currentPath = Astro.url.pathname.replace(/^\/ru(?:\/|$)/, '').replace(/^\/+|\/+$/g, '')
const homeUrl = getRelativeLocaleUrl(lang, '/')
const languageUrl = getRelativeLocaleUrl(targetLang, currentPath)
const languageLabel = lang === 'en' ? 'Russian' : 'English'
const author = { en: 'Teplostanski Igor', ru: 'Игорь Теплостанский' }
---

<!doctype html>
<html lang={lang}>
  <!--
╭─────╮ ✧
│ ◠ ◡ ◠
╰─────╯
glhf!
-->
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="description" content="Igor Teplostanski. Open-source enthusiast building tools, REST APIs, CLIs, and web apps with TypeScript." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="teplostanski.me" />
    <meta property="og:title" content="teplostanski.me" />
    <meta property="og:description" content="Igor Teplostanski. Open-source enthusiast building tools, REST APIs, CLIs, and web apps with TypeScript." />
    <meta property="og:url" content={`https://teplostanski.me${Astro.url.pathname}`} />
    <meta property="og:image" content="https://teplostanski.me/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="teplostanski.me, personal website of Igor Teplostanski" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="teplostanski.me" />
    <meta name="twitter:description" content="Igor Teplostanski. Open-source enthusiast building tools, REST APIs, CLIs, and web apps with TypeScript." />
    <meta name="twitter:image" content="https://teplostanski.me/og-image.png" />
    <title>teplostanski.me</title>
  </head>
  <body>
    <main class="layout">
      <h1 class="layout-logo" aria-label={author[lang]}>
        <a href={homeUrl}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="43"
            height="6"
            viewBox="0 0 43 6"
            shape-rendering="crispEdges"
            aria-hidden="true"
            focusable="false"
          >
            <path
              fill="currentColor"
              d="M0 0h1v5h-1zM12 0h1v5h-1zM22 0h1v5h-1zM38 0h1v5h-1zM42 0h1v1h-1zM1 1h2v1h-2zM4 1h3v1h-3zM8 1h3v1h-3zM14 1h3v1h-3zM18 1h3v1h-3zM23 1h2v1h-2zM26 1h3v1h-3zM30 1h2v1h-2zM34 1h3v1h-3zM40 1h1v1h-1zM4 2h1v3h-1zM6 2h1v1h-1zM8 2h1v4h-1zM10 2h1v3h-1zM14 2h1v3h-1zM16 2h1v3h-1zM18 2h1v1h-1zM26 2h1v3h-1zM28 2h1v3h-1zM30 2h1v3h-1zM32 2h1v3h-1zM34 2h1v1h-1zM39 2h1v1h-1zM42 2h1v3h-1zM2 3h1v2h-1zM20 3h1v2h-1zM24 3h1v2h-1zM27 3h1v1h-1zM36 3h1v2h-1zM40 3h1v2h-1zM1 4h1v1h-1zM5 4h2v1h-2zM9 4h1v1h-1zM15 4h1v1h-1zM18 4h2v1h-2zM23 4h1v1h-1zM34 4h2v1h-2z"
            />
          </svg>
        </a>
      </h1>

      <slot />

      <footer class="layout-footer">
        © 2022-present Teplostanski Igor.
        <ul class="layout-links">
          <li>
            <a
              href="https://heartbeat.teplostanski.me"
              target="_blank"
              rel="noopener noreferrer"
            >
              Heartbeat
            </a>
          </li>
          <li>
            <a href={languageUrl} hreflang={targetLang} data-language-switcher>
              {languageLabel}
            </a>
          </li>
        </ul>
      </footer>
    </main>
  </body>
</html>

<style>
  .layout {
    margin-inline: auto;
    max-width: var(--frame-width);
  }

  .layout-logo {
    width: 270px;
    color: var(--heading);

    & a {
      color: inherit;
    }

    & svg {
      width: 100%;
      height: auto;
    }
  }

  .layout-footer {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .layout-links {
    display: flex;
    gap: 0.65rem;
  }

  @media (min-width: 640px) {
    .layout-logo {
      width: 370px;
    }
  }
</style>
